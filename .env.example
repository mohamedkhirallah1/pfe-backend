# --- Server ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
BACKEND_URL=http://localhost:3001

# --- CORS (comma-separated list of allowed browser origins, no wildcard in production) ---
CORS_ORIGIN=http://localhost:3000
WS_CORS_ORIGIN=http://localhost:3000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/smart_fiber

# --- Redis / BullMQ (external-events queue) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Upstream websocket source consumed by WebsocketClientService ---
WS_SERVER_URL=http://localhost:3000

# --- Auth & Cryptography ---
# Required. No default is provided on purpose: the app refuses to start without it.
JWT_SECRET=change-this-to-a-long-random-value
JWT_EXPIRES_IN=1d
# 256-bit AES encryption key for PII at rest (CIN, phone numbers)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Secret pepper for deterministic HMAC-SHA256 Blind Indexing
BLIND_INDEX_PEPPER=smart-fiber-secret-blind-index-pepper-value

# --- Internal webhook ingestion (/api/events, /api/contract/*, /api/nro/*, /api/reclamation/*) ---
# Required. Requests must send this value in the `x-api-key` header.
EVENTS_API_KEY=change-this-to-a-long-random-value

# --- AI supervisor agent (Groq LLM) ---
# Optional. Without it, the supervisor still runs (saturation detection, auto-fix,
# notifications) but falls back to a templated recommendation instead of an LLM-generated one.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Hard timeout per Groq HTTP call (ms). On timeout, that call falls back to the deterministic
# path — the rest of the analysis is never blocked waiting on Groq.
GROQ_TIMEOUT_MS=15000
# Bounded retry count for 429/5xx responses only (never for 4xx like bad request/invalid key).
# retry N waits longer than retry N-1 (see GroqService.backoffMs); after GROQ_MAX_RETRIES the
# call falls back to deterministic output — this is never an unbounded loop.
GROQ_MAX_RETRIES=2
# Minimum spacing enforced between Groq calls by GroqService's internal single-flight queue,
# regardless of how many agents request a completion "at the same time". This is the main lever
# against tokens-per-minute rate limits (429) — raise it if you still see 429s.
GROQ_MIN_INTERVAL_MS=3000
# Caps max_tokens on every Groq request so a single call can't itself exhaust the TPM budget.
GROQ_MAX_OUTPUT_TOKENS=600
# Circuit breaker: after this many consecutive Groq failures (429/5xx), calls are short-circuited
# to the deterministic fallback (no network call) for AI_GROQ_CIRCUIT_COOLDOWN_MS, then a single
# trial call decides whether to close the circuit again or re-open it.
AI_GROQ_CIRCUIT_FAILURE_THRESHOLD=4
AI_GROQ_CIRCUIT_COOLDOWN_MS=60000

# --- Infrastructure Planner (new NRO/FDT proposals) ---
# Saturation % that triggers evaluating whether a new NRO/FDT is needed. Matches the existing
# "critical" threshold already used elsewhere in ai-supervisor (FdtCapacityAgent, saturation
# alerts) — kept the same value by default, not a new arbitrary number.
INFRA_PLANNER_NRO_CRITICAL_PCT=90
INFRA_PLANNER_FDT_CRITICAL_PCT=90
# A candidate location must cover at least this many contracts to be considered.
INFRA_PLANNER_MIN_CONTRACTS=5
# A candidate closer than this to an existing NRO/FDT is rejected as a likely duplicate.
INFRA_PLANNER_MIN_DISTANCE_KM=0.5

# --- Optional one-time admin bootstrap on boot (disabled by default) ---
# Prefer `npm run seed` for initial setup. Only set these if you explicitly want the app
# to create an admin account on startup when none exists yet.
SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
