# ==========================================
# SMART FIBER - AZURE PRODUCTION ENVIRONMENT
# ==========================================

# --- Application URLs ---
# Set this to your Azure domain (e.g. https://smart-fiber.francecentral.cloudapp.azure.com or http://<VM_PUBLIC_IP>)
BACKEND_URL=https://smart-fiber.francecentral.cloudapp.azure.com
CORS_ORIGIN=*
WS_CORS_ORIGIN=*

# --- Security & Secrets (Generate secure random values) ---
JWT_SECRET=production-secret-replace-with-64-character-random-hex-string
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BLIND_INDEX_PEPPER=smart-fiber-azure-production-pepper-secret-key-replace-me

# --- Internal API Ingestion Key ---
EVENTS_API_KEY=events-api-key-replace-with-secure-random-token

# --- AI Supervisor (Groq API Key) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# --- Initial Admin Auto-Bootstrap (optional on first boot) ---
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=AdminStrongPassword2026!
