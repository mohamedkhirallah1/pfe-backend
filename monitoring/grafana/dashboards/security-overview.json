          "range": true,
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(smartfiber_http_request_duration_seconds_bucket[1m])) by (le))",
